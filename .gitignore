# Go
/dist/
/bin/
*.test
*.out
coverage.*

# Frontend
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
*.log

# Go workspace files are never committed
go.work
go.work.sum

# Local Claude Code settings (per-machine)
.claude/settings.local.json
.claude/.headroom_wrap_settings.lock

# Task checksum cache
.task/

# Local scratch (diagrams, notes), never committed
/tmp/
.serena/
.windsurf/
.devin/
.claude/
skills-lock.json
.agents/skills/*
.hallmark/
.impeccable/
